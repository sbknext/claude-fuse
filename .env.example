CLAUDE_FUSE_DB=./data/metadata.db
CLAUDE_FUSE_DATA_DIR=./data
CLAUDE_FUSE_API_PORT=5457
CLAUDE_FUSE_DASHBOARD_PORT=5460
CLAUDE_FUSE_API_URL=http://localhost:5457
CLAUDE_FUSE_USER=me
CLAUDE_FUSE_LEDGER_PATH=../MISTAKES_LEDGER.md

# Real-time mistake alerts (Story 1.5.5)
# Comma-separated channels: telegram, log — or "none" to disable (default)
CLAUDE_FUSE_ALERT_CHANNELS=none
# Telegram bot token + chat ID (required when telegram channel is enabled)
# CLAUDE_FUSE_TELEGRAM_BOT_TOKEN=
# CLAUDE_FUSE_TELEGRAM_CHAT_ID=
# How long a session must have had a recent event to be considered "active" (minutes, default 5)
CLAUDE_FUSE_ACTIVE_SESSION_WINDOW_MINUTES=5
