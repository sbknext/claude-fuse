CLAUDE_FUSE_DB=./data/metadata.db
CLAUDE_FUSE_DATA_DIR=./data
CLAUDE_FUSE_API_PORT=5457
CLAUDE_FUSE_DASHBOARD_PORT=5460
CLAUDE_FUSE_API_URL=http://localhost:5457
CLAUDE_FUSE_USER=me
CLAUDE_FUSE_LEDGER_PATH=../MISTAKES_LEDGER.md

# Real-time mistake alerts (Story 1.5.5)
# Comma-separated channels: telegram, log — or "none" to disable (default)
CLAUDE_FUSE_ALERT_CHANNELS=none
# Telegram bot token + chat ID (required when telegram channel is enabled)
# CLAUDE_FUSE_TELEGRAM_BOT_TOKEN=
# CLAUDE_FUSE_TELEGRAM_CHAT_ID=
# How long a session must have had a recent event to be considered "active" (minutes, default 5)
CLAUDE_FUSE_ACTIVE_SESSION_WINDOW_MINUTES=5

# Skill stub auto-templating (Story 1.5.6)
# Optional: set to an Anthropic API key to enable "Explain stub (AI)" button.
# If unset, stubs are generated without AI fields — the Generate stub button still works.
# The AI call sends ONLY tool names + call counts — no raw session JSONL content.
# CLAUDE_FUSE_AI_API_KEY=
# Optional: override AI model (default: claude-haiku-4-5)
# CLAUDE_FUSE_AI_MODEL=claude-haiku-4-5
# Optional: override AI base URL (default: https://api.anthropic.com)
# CLAUDE_FUSE_AI_BASE_URL=https://api.anthropic.com
# Set to "1" in dashboard/.env.local to show the "Explain stub (AI)" button in the UI
# (only when CLAUDE_FUSE_AI_API_KEY is also configured on the API side)
# NEXT_PUBLIC_CLAUDE_FUSE_AI_KEY_SET=1
